# Serverda: cp deploy/.env.example deploy/.env  va qiymatlarni to'ldiring.
# Bu fayl git'ga tushmaydi.

# Kalit yaratish: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Domen. "backend" va "127.0.0.1" — konteynerlar ichki murojaati uchun, o'chirmang.
DJANGO_ALLOWED_HOSTS=yoshlar-texnoparki.uz,www.yoshlar-texnoparki.uz,backend,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://yoshlar-texnoparki.uz,https://www.yoshlar-texnoparki.uz
PUBLIC_BASE_URL=https://yoshlar-texnoparki.uz
CORS_ALLOWED_ORIGINS=https://yoshlar-texnoparki.uz,https://www.yoshlar-texnoparki.uz

APPLICATIONS_THROTTLE_RATE=10/hour

# Ixtiyoriy: ma'lumotlar papkasi (standart: /opt/texnopark/data)
# DATA_DIR=/opt/texnopark/data

# Serverdagi portlar (boshqa loyihalar bilan to'qnashmasligi uchun)
# BACKEND_PORT=8010
# FRONTEND_PORT=3010
